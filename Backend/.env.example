PORT=5000
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/goveaseai

# AgentRouter (primary AI provider)
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://co.agentrouter.org/v1
AGENTROUTER_MODEL=deepseek-v4-flash
AGENTROUTER_VISION_MODEL=deepseek-v4-flash
AGENTROUTER_DOCUMENT_MODEL=deepseek-v4-flash

# OpenRouter (fallback / secondary provider)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
OPENROUTER_DOCUMENT_MODEL=google/gemini-2.5-flash
OPENROUTER_AUDIO_MODEL=google/gemini-2.5-flash
OPENROUTER_VIDEO_MODEL=

# Gemini Direct API (fallback provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# AI Provider selection: agentrouter | openrouter | gemini
AI_PROVIDER=agentrouter

JWT_SECRET_KEY=your-secret-jwt-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
